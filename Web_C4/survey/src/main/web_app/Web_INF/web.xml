<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.0">

    <servlet>
        <servlet-name>EmailListServlet</servlet-name>
        <servlet-class>murach.email.EmailListServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>EmailListServlet</servlet-name>
        <url-pattern>/emailList</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SurveyServlet</servlet-name>
        <servlet-class>survery.SurveryServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>SurveyServlet</servlet-name>
        <url-pattern>/survey</url-pattern>
    </servlet-mapping>

</web-app>
